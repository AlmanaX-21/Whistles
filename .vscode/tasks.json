{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Client",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runClient"],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Starting.*",
                    "endsPattern": "^.*Server started.*"
                }
            }
        },
        {
            "label": "Build Mod",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["build"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$gradle"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build and Run Client",
            "dependsOn": ["Build Mod", "Run Client"],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "build"
            }
        }
    ]
}
